rules_version = '2';
// Only the two listed accounts can read or change the shared budget.
// Paste this into Firebase console → Firestore Database → Rules, then Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    function allowed() {
      return request.auth != null
        && request.auth.token.email.lower() in ['YOUR_EMAIL@example.com', 'HER_EMAIL@example.com'];
    }
    match /households/home {
      allow read, write: if allowed();
    }
    match /households/home/{document=**} {
      allow read, write: if allowed();
    }
  }
}
